{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/hooks/check-line-length.ts\""
          }
        ]
      }
    ]
  }
}
