{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@toverux/blanc-hopital/tsconfig/strict", "@toverux/blanc-hopital/tsconfig/bun"],
  "compilerOptions": {
    // Config files and scripts/ run under bun; the wards hook and CLI run under the user's node.
    "types": ["node"],
    // The wards CLI is multi-file and Node's type stripping needs the explicit .ts extension in
    // import specifiers, so tsc must accept them too (permitted because the bun preset sets noEmit).
    "allowImportingTsExtensions": true
  },
  // The default globs skip dot-directories, which would leave the installed hook this repo actually
  // runs unchecked; it is named explicitly so it is type-checked like the scroll it came from.
  "include": ["**/*.ts", "**/*.tsx", ".agents/hooks/**/*.ts"]
}
