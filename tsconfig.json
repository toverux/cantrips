{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@toverux/blanc-hopital/tsconfig/strict", "@toverux/blanc-hopital/tsconfig/bun"],
  "compilerOptions": {
    // Config files and scripts/ run under bun; the hook runs under the user's node.
    "types": ["node"]
  },
  // The default globs skip dot-directories, which would leave the hook this repo actually runs
  // unchecked; it is named explicitly so it is type-checked like any other source file.
  "include": ["**/*.ts", "**/*.tsx", ".agents/hooks/**/*.ts"]
}
